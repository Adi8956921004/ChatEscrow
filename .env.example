# ============================================================
# ChatEscrow – Deployment Environment Configuration Template
# Copy to .env and fill in your values.
# NEVER commit .env or real secrets to source control.
# ============================================================

# ── Application & URLs ──────────────────────────────────────
SERVER_PORT=8080
APP_BASE_URL=http://localhost:5173
CHATESCROW_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443,http://localhost:3000,http://localhost:80,http://localhost

# Frontend API Base URL
# Leave blank or "/" for same-host / Nginx deployment; or set to backend URL if hosted on a separate domain.
VITE_API_BASE_URL=

# ── Database ────────────────────────────────────────────────
# Default: H2 in-memory (zero setup, ideal for demos & tests)
SPRING_DATASOURCE_URL=jdbc:h2:mem:chatescrow;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Optional: PostgreSQL (uncomment for persistent production deployments)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chatescrow
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=chatescrow
# SPRING_DATASOURCE_PASSWORD=chatescrow_secret

# ── AI Provider (Google Gemini) ─────────────────────────────
# Get your API key at: https://aistudio.google.com/app/apikey
AI_API_KEY=replace-with-your-gemini-api-key
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── PayPal Sandbox (Backend Only) ───────────────────────────
# Get sandbox credentials at: https://developer.paypal.com/dashboard/
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-secret
PAYPAL_WEBHOOK_ID=replace-after-registering-webhook
PAYPAL_ENABLE_PAYOUTS=false

# ── Security & Authentication Tokens ────────────────────────
# Bearer tokens for demo accounts (override in production)
APP_CLIENT_TOKEN=client-demo-token
APP_FREELANCER_TOKEN=freelancer-demo-token
