# ============================================================
# ChatEscrow – Environment Variables Template
# Copy to .env and fill in your values.
# NEVER commit .env or real credentials to source control.
# ============================================================

# Server
APP_BASE_URL=http://localhost:8080

# AI provider (Google Gemini recommended)
# Get your key at: https://aistudio.google.com/app/apikey
AI_API_KEY=replace-with-your-gemini-api-key
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# PayPal Sandbox — BACKEND ONLY (never expose client secret to frontend)
# Get credentials at: https://developer.paypal.com/dashboard/
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-secret
PAYPAL_WEBHOOK_ID=replace-after-registering-webhook
PAYPAL_ENABLE_PAYOUTS=false

# Frontend (Vite) — only public client ID, no secrets
VITE_PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
VITE_API_BASE_URL=http://localhost:8080
